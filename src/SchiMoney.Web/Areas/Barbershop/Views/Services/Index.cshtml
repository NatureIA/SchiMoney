@model List<BarbershopService>
@{
    ViewData["Title"] = "Serviços";
}
<div class="page-actions">
    <p class="page-intro">Catálogo de serviços usado para agilizar o registro das vendas.</p>
</div>

<div class="services-layout">
<section class="panel">
<div class="panel-head">
    <div>
        <span class="eyebrow">Catálogo</span>
        <h2>Serviços cadastrados</h2>
    </div>
</div>

@if(Model.Count==0)
{
    <div class="empty-mini">Nenhum serviço cadastrado.</div>
}

<div class="service-editor-list">
@foreach(var item in Model)
{
<form asp-action="Update" method="post" class="service-editor @(item.Active?"":"service-disabled")">
    <input type="hidden" name="id" value="@item.Id" />
    <div class="service-editor-fields">
        <input name="name" value="@item.Name" required />
    </div>
    <div class="service-editor-actions">
        <span class="status @(item.Active?"pago":"pendente")">@(item.Active?"Ativo":"Inativo")</span>
        <button class="mini-action" type="submit">Salvar</button>
        <button class="mini-action" type="submit" formaction="@Url.Action("Toggle")">@(item.Active?"Desativar":"Ativar")</button>
        <button class="icon-btn" type="submit" formaction="@Url.Action("Delete")" onclick="return confirm('Excluir este serviço?')">×</button>
    </div>
</form>
}
</div>
</section>

<section class="panel">
<div class="panel-head">
    <div>
        <span class="eyebrow">Novo</span>
        <h2>Adicionar serviço</h2>
    </div>
</div>

<form asp-action="Create" method="post" class="smart-form compact">
    <label>
        <span>Nome</span>
        <input name="name" required placeholder="Ex.: Corte premium" />
    </label>
    <button class="primary-btn" type="submit">Adicionar serviço</button>
</form>
</section>
</div>
