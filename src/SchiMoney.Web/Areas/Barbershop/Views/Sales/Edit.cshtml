@model BarbershopSale
@{
    ViewData["Title"] = "Editar venda";
    var services = ViewBag.Services as List<BarbershopService> ?? [];
    var newServiceName = ViewBag.NewServiceName as string ?? string.Empty;
    var isRecurring = Model.RecurringSeriesId.HasValue;
    var recurrenceActive = ViewBag.RecurrenceActive == true;
}
<div class="form-shell">
<div class="form-heading">
    <span class="eyebrow">Barbearia</span>
    <h2>Editar venda</h2>
    <p>Ajuste serviço, valor ou forma de pagamento.</p>
</div>

@if (isRecurring)
{
    <div class="insight-card">
        <span class="insight-badge">Venda recorrente</span>
        @if (recurrenceActive)
        {
            <p>As alterações feitas aqui passam a valer desta ocorrência em diante. Os meses anteriores permanecem preservados.</p>
        }
        else
        {
            <p>Esta recorrência foi encerrada. Os meses anteriores continuam no histórico.</p>
        }
    </div>
}

<form method="post" class="smart-form">
<div asp-validation-summary="ModelOnly" class="validation"></div>

<div class="field-grid two">
<label>
    <span>Serviço</span>
    <select asp-for="ServiceName" data-service required>
        @if (!services.Any(x => x.Name == Model.ServiceName) && Model.ServiceName != "__new__")
        {
            <option value="@Model.ServiceName">@Model.ServiceName</option>
        }

        @foreach (var s in services)
        {
            <option value="@s.Name">@s.Name</option>
        }

        <option value="__new__">+ Criar novo serviço</option>
    </select>
    <span asp-validation-for="ServiceName" class="validation"></span>
</label>

<label>
    <span>Valor</span>
    <input asp-for="Amount" type="number" step="0.01" min="0.01" required />
</label>
</div>

<div data-new-service-block hidden>
    <label>
        <span>Nome do novo serviço</span>
        <input type="text"
               name="newServiceName"
               value="@newServiceName"
               maxlength="120"
               data-new-service-name
               placeholder="Ex.: Sobrancelha, hidratação, pigmentação..." />
        <small>Depois de salvar, ele ficará disponível nas próximas vendas.</small>
    </label>
</div>

<div class="field-grid two">
<label>
    <span>Pagamento</span>
    <select asp-for="PaymentMethod">
        <option>Pix</option>
        <option>Dinheiro</option>
        <option>Débito</option>
        <option>Crédito</option>
        <option>Transferência</option>
    </select>
</label>

<label>
    <span>Cliente</span>
    <input asp-for="CustomerName" />
</label>
</div>

<label>
    <span>Observações</span>
    <textarea asp-for="Notes" rows="3"></textarea>
</label>

<div class="form-actions">
    <a class="secondary-btn" asp-action="Index">Cancelar</a>
    <button class="primary-btn" type="submit">Salvar alterações</button>
</div>
</form>

@if (isRecurring && recurrenceActive && Model.RecurringSeriesId.HasValue)
{
    <form asp-action="EndRecurring"
          method="post"
          class="form-actions"
          onsubmit="return confirm('Encerrar esta recorrência? Os meses já lançados serão mantidos.')">
        <input type="hidden" name="seriesId" value="@Model.RecurringSeriesId.Value" />
        <button class="secondary-btn" type="submit">Encerrar recorrência</button>
    </form>
}
</div>
