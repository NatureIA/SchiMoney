@model BarbershopExpense
@{
    ViewData["Title"] = "Editar despesa";
    var categories = ViewBag.Categories as List<string> ?? [];
    var newCategoryName = ViewBag.NewCategoryName as string ?? string.Empty;
    var isRecurring = Model.RecurringSeriesId.HasValue;
    var recurrenceActive = ViewBag.RecurrenceActive == true;
}
<div class="form-shell">
<div class="form-heading">
    <span class="eyebrow">Barbearia</span>
    <h2>Editar despesa</h2>
    @if (isRecurring)
    {
        <p>Recorrência de @Model.Date.ToString("dd/MM/yyyy").</p>
    }
    else if (Model.InstallmentTotal.HasValue)
    {
        <p>Parcela @Model.InstallmentNumber/@Model.InstallmentTotal · competência @Model.Date.ToString("dd/MM/yyyy").</p>
    }
    else
    {
        <p>Lançamento de @Model.Date.ToString("dd/MM/yyyy").</p>
    }
</div>

@if (isRecurring)
{
    <div class="insight-card">
        <span class="insight-badge">Despesa recorrente</span>
        @if (recurrenceActive)
        {
            <p>As alterações feitas aqui passam a valer desta ocorrência em diante. Os meses anteriores permanecem preservados.</p>
        }
        else
        {
            <p>Esta recorrência foi encerrada. Os lançamentos anteriores continuam no histórico.</p>
        }
    </div>
}

<form method="post" class="smart-form">
<div asp-validation-summary="ModelOnly" class="validation"></div>

<div class="field-grid two">
<label><span>Descrição</span><input asp-for="Description" required /></label>
<label><span>Valor</span><input asp-for="Amount" type="number" step="0.01" min="0.01" required /></label>
</div>

<div class="field-grid two">
<label>
    <span>Categoria</span>
    <select asp-for="Category" data-expense-category>
        @foreach (var category in categories)
        {
            <option value="@category">@category</option>
        }
        <option value="__new__">+ Criar nova categoria</option>
    </select>
    <span asp-validation-for="Category" class="validation"></span>
</label>
<label>
    <span>Tipo</span>
    <select asp-for="ExpenseType">
        <option>Fixa</option>
        <option>Variável</option>
    </select>
</label>
</div>

<div data-new-expense-category-block hidden>
    <label>
        <span>Nome da nova categoria</span>
        <input type="text"
               name="newCategoryName"
               value="@newCategoryName"
               maxlength="80"
               data-new-expense-category-name
               placeholder="Ex.: Funcionários, Contabilidade, Limpeza..." />
    </label>
</div>

<label>
    <span>Pagamento</span>
    <select asp-for="PaymentMethod">
        <option>Pix</option>
        <option>Dinheiro</option>
        <option>Débito</option>
        <option>Crédito</option>
        <option>Boleto</option>
        <option>Transferência</option>
    </select>
</label>

<label class="check-row">
    <input asp-for="Paid" />
    <span>Despesa paga</span>
</label>

<label>
    <span>Observações</span>
    <textarea asp-for="Notes" rows="3"></textarea>
</label>

<div class="form-actions">
    <a class="secondary-btn" asp-action="Index">Cancelar</a>
    <button class="primary-btn" type="submit">Salvar alterações</button>
</div>
</form>

@if (isRecurring && recurrenceActive && Model.RecurringSeriesId.HasValue)
{
    <form asp-action="EndRecurring" method="post" class="form-actions"
          onsubmit="return confirm('Encerrar esta recorrência? Os meses já lançados serão mantidos.')">
        <input type="hidden" name="seriesId" value="@Model.RecurringSeriesId.Value" />
        <button class="secondary-btn" type="submit">Encerrar recorrência</button>
    </form>
}
</div>
