@model List<BarbershopExpense>
@{
    ViewData["Title"] = "Despesas";
}
<div class="page-actions"><p class="page-intro">Custos fixos, variáveis, pagos e pendentes da Barbearia.</p><a class="primary-btn" asp-action="Create">+ Nova despesa</a></div>

<form method="get" class="filter-panel">
<input name="q" value="@ViewBag.Q" placeholder="Buscar descrição..." />
<select name="status"><option value="">Todos os status</option><option value="Pago" selected="@(ViewBag.Status=="Pago" ? "selected" : null)">Pago</option><option value="Pendente" selected="@(ViewBag.Status=="Pendente" ? "selected" : null)">Pendente</option></select>
<select name="category"><option value="">Todas as categorias</option><option>Aluguel</option><option>Água</option><option>Energia</option><option>Internet</option><option>Produtos</option><option>Materiais</option><option>Marketing</option><option>Impostos</option><option>Manutenção</option><option>Equipamentos</option><option>Taxas</option><option>Outros</option></select>
<input name="month" type="number" min="1" max="12" value="@ViewBag.Month" placeholder="Mês" />
<input name="year" type="number" min="2020" max="2100" value="@ViewBag.Year" placeholder="Ano" />
<button class="secondary-btn" type="submit">Filtrar</button><a class="filter-clear" asp-action="Index">Limpar</a>
</form>

<div class="table-card">
<table class="data-table">
<thead><tr><th>Data</th><th>Descrição</th><th>Categoria</th><th>Tipo</th><th>Status</th><th class="right">Valor</th><th class="right">Ações</th></tr></thead>
<tbody>
@if(Model.Count==0){<tr><td colspan="7" class="empty-cell">Nenhuma despesa encontrada.</td></tr>}
@foreach(var item in Model){
<tr>
<td>@item.Date.ToString("dd/MM/yyyy")</td><td><strong>@item.Description</strong>@if(item.DueDate.HasValue){<small class="table-sub">Vence @item.DueDate.Value.ToString("dd/MM")</small>}</td><td>@item.Category</td><td>@item.ExpenseType</td>
<td><span class="status @(item.Paid?"pago":"pendente")">@(item.Paid?"Pago":"Pendente")</span></td><td class="right negative">- @item.Amount.ToString("C")</td>
<td class="right actions-cell">@if(!item.Paid){<form asp-action="MarkPaid" asp-route-id="@item.Id" method="post"><button class="mini-action success-action" type="submit">Dar baixa</button></form>}<a class="mini-action" asp-action="Edit" asp-route-id="@item.Id">Editar</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Excluir esta despesa?')"><button class="icon-btn" type="submit">×</button></form></td>
</tr>}
</tbody></table></div>
