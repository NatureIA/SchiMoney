@model List<BarbershopExpense>
@{
    ViewData["Title"] = "Despesas";
}
<div class="page-actions"><p class="page-intro">Custos e despesas exclusivos da Barbearia.</p><a class="primary-btn" asp-action="Create">+ Nova despesa</a></div>
<div class="table-card">
<table class="data-table">
<thead><tr><th>Data</th><th>Descrição</th><th>Categoria</th><th>Tipo</th><th>Status</th><th class="right">Valor</th><th></th></tr></thead>
<tbody>
@if(Model.Count == 0){<tr><td colspan="7" class="empty-cell">Nenhuma despesa registrada.</td></tr>}
@foreach(var item in Model){
<tr>
<td>@item.Date.ToString("dd/MM/yyyy")</td><td><strong>@item.Description</strong></td><td>@item.Category</td><td>@item.ExpenseType</td>
<td><span class="status @(item.Paid ? "pago" : "pendente")">@(item.Paid ? "Pago" : "Pendente")</span></td>
<td class="right negative">- @item.Amount.ToString("C")</td>
<td class="right"><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Excluir esta despesa?')"><button class="icon-btn" type="submit">×</button></form></td>
</tr>}
</tbody></table></div>
