@model BarbershopExpense
@{
    ViewData["Title"] = "Nova despesa";
    var categories = ViewBag.Categories as List<string> ?? [];
    var newCategoryName = ViewBag.NewCategoryName as string ?? string.Empty;
    var installmentCount = ViewBag.InstallmentCount is int count ? count : 1;
    var firstBoletoDate = ViewBag.FirstBoletoDate as string ?? string.Empty;
}
<div class="form-shell">
<div class="form-heading">
    <span class="eyebrow">Barbearia</span>
    <h2>Registrar despesa</h2>
    <p>O SchiMoney define automaticamente a competência conforme a forma de pagamento.</p>
</div>

<form method="post" class="smart-form">
<div asp-validation-summary="ModelOnly" class="validation"></div>

<div class="field-grid two">
<label>
    <span>Descrição</span>
    <input asp-for="Description" placeholder="Ex.: Aluguel, energia, produtos" required />
</label>
<label>
    <span>Valor total</span>
    <input asp-for="Amount" type="number" step="0.01" min="0.01" required />
</label>
</div>

<div class="field-grid two">
<label>
    <span>Categoria</span>
    <select asp-for="Category" data-expense-category>
        @foreach (var category in categories)
        {
            <option value="@category">@category</option>
        }
        <option value="__new__">+ Criar nova categoria</option>
    </select>
    <span asp-validation-for="Category" class="validation"></span>
</label>

<label>
    <span>Tipo</span>
    <select asp-for="ExpenseType">
        <option>Fixa</option>
        <option>Variável</option>
    </select>
</label>
</div>

<div data-new-expense-category-block hidden>
    <label>
        <span>Nome da nova categoria</span>
        <input type="text"
               name="newCategoryName"
               value="@newCategoryName"
               maxlength="80"
               data-new-expense-category-name
               placeholder="Ex.: Funcionários, Contabilidade, Limpeza..." />
        <small>Depois de salvar, essa categoria ficará disponível nas próximas despesas.</small>
    </label>
</div>

<div class="field-grid two">
<label>
    <span>Pagamento</span>
    <select asp-for="PaymentMethod" data-expense-payment>
        <option>Pix</option>
        <option>Dinheiro</option>
        <option>Débito</option>
        <option>Crédito</option>
        <option>Boleto</option>
        <option>Transferência</option>
    </select>
</label>

<label data-expense-installments hidden>
    <span data-expense-installment-label>Quantidade de parcelas</span>
    <input type="number"
           name="installmentCount"
           value="@installmentCount"
           min="1"
           max="120"
           data-expense-installment-count />
    <small data-expense-installment-help>O valor total será dividido automaticamente.</small>
</label>
</div>

<div data-expense-boleto-date hidden>
    <label>
        <span>Data do primeiro boleto</span>
        <input type="date"
               name="firstBoletoDate"
               value="@firstBoletoDate"
               data-first-boleto-date />
        <small>Os próximos boletos serão projetados mensalmente a partir desta data.</small>
    </label>
</div>

<label class="check-row" data-expense-paid-block>
    <input asp-for="Paid" />
    <span>Despesa já paga</span>
</label>

<div class="insight-card" data-expense-payment-info>
    <span class="insight-badge">Competência automática</span>
    <p data-expense-payment-message>Este lançamento será registrado na data atual.</p>
</div>

<label>
    <span>Observações</span>
    <textarea asp-for="Notes" rows="3"></textarea>
</label>

<div class="form-actions">
    <a class="secondary-btn" asp-action="Index">Cancelar</a>
    <button class="primary-btn" type="submit">Salvar despesa</button>
</div>
</form>
</div>
