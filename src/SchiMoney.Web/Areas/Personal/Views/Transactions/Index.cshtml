@model List<PersonalTransaction>
@{
    ViewData["Title"] = "Lançamentos";
}
<div class="page-actions">
    <p class="page-intro">Todos os lançamentos do módulo Pessoal.</p>
    <a class="primary-btn" asp-action="Create">+ Novo lançamento</a>
</div>

<div class="filter-row">
    <a asp-action="Index">Todos</a>
    <a asp-action="Index" asp-route-type="Receita">Receitas</a>
    <a asp-action="Index" asp-route-type="Despesa">Despesas</a>
</div>

<div class="table-card">
<table class="data-table">
    <thead><tr><th>Data</th><th>Descrição</th><th>Categoria</th><th>Pagamento</th><th>Status</th><th class="right">Valor</th><th></th></tr></thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="7" class="empty-cell">Nenhum lançamento cadastrado.</td></tr>
    }
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Date.ToString("dd/MM/yyyy")</td>
            <td><strong>@item.Description</strong>@if(item.InstallmentTotal is > 1){<small class="table-sub">@item.InstallmentNumber/@item.InstallmentTotal</small>}</td>
            <td>@item.Category</td>
            <td>@item.PaymentMethod</td>
            <td><span class="status @item.Status.ToLower()">@item.Status</span></td>
            <td class="right @(item.Type == "Receita" ? "positive" : "negative")">@((item.Type == "Receita" ? "+" : "-")) @item.Amount.ToString("C")</td>
            <td class="right">
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Excluir este lançamento?')">
                    <button class="icon-btn" type="submit">×</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
