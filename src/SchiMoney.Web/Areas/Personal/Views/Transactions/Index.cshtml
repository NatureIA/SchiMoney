@model List<PersonalTransaction>
@{
    ViewData["Title"] = "Lançamentos";
}
<div class="page-actions">
    <p class="page-intro">Consulte, filtre, edite e dê baixa nas movimentações do módulo Pessoal.</p>
    <a class="primary-btn" asp-action="Create">+ Novo lançamento</a>
</div>

<form method="get" class="filter-panel">
    <input name="q" value="@ViewBag.Q" placeholder="Buscar descrição, categoria ou conta..." />
    <select name="type">
        <option value="">Receita + despesa</option>
        <option value="Receita" selected="@(ViewBag.Type=="Receita" ? "selected" : null)">Receita</option>
        <option value="Despesa" selected="@(ViewBag.Type=="Despesa" ? "selected" : null)">Despesa</option>
    </select>
    <select name="status">
        <option value="">Todos os status</option>
        <option value="Pago" selected="@(ViewBag.Status=="Pago" ? "selected" : null)">Pago</option>
        <option value="Pendente" selected="@(ViewBag.Status=="Pendente" ? "selected" : null)">Pendente</option>
        <option value="Vencido" selected="@(ViewBag.Status=="Vencido" ? "selected" : null)">Vencido</option>
    </select>
    <input name="month" type="number" min="1" max="12" value="@ViewBag.Month" placeholder="Mês" />
    <input name="year" type="number" min="2020" max="2100" value="@ViewBag.Year" placeholder="Ano" />
    <button class="secondary-btn" type="submit">Filtrar</button>
    <a class="filter-clear" asp-action="Index">Limpar</a>
</form>

<div class="table-card">
<table class="data-table">
    <thead><tr><th>Data</th><th>Descrição</th><th>Categoria</th><th>Pagamento</th><th>Status</th><th class="right">Valor</th><th class="right">Ações</th></tr></thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="7" class="empty-cell">Nenhum lançamento encontrado.</td></tr>
    }
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Date.ToString("dd/MM/yyyy")</td>
            <td><strong>@item.Description</strong>@if(item.InstallmentTotal is > 1){<small class="table-sub">@item.RecurrenceType @item.InstallmentNumber/@item.InstallmentTotal</small>}</td>
            <td>@item.Category</td>
            <td>@item.PaymentMethod @if(!string.IsNullOrWhiteSpace(item.AccountName)){<small class="table-sub">@item.AccountName</small>}</td>
            <td><span class="status @item.Status.ToLower()">@item.Status</span></td>
            <td class="right @(item.Type == "Receita" ? "positive" : "negative")">@((item.Type == "Receita" ? "+" : "-")) @item.Amount.ToString("C")</td>
            <td class="right actions-cell">
                @if(item.Status != "Pago")
                {
                    <form asp-action="MarkPaid" asp-route-id="@item.Id" method="post"><button class="mini-action success-action" type="submit">Dar baixa</button></form>
                }
                <a class="mini-action" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Excluir este lançamento?')"><button class="icon-btn" type="submit">×</button></form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
