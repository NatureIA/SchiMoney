@model PersonalTransaction
@{
    ViewData["Title"] = "Novo lançamento";
}
<div class="form-shell">
    <div class="form-heading">
        <span class="eyebrow">Módulo Pessoal</span>
        <h2>Registrar movimentação</h2>
        <p>Cadastre receita ou despesa. Parcelamentos geram as parcelas automaticamente.</p>
    </div>

    <form method="post" class="smart-form">
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="segmented">
            <label><input type="radio" asp-for="Type" value="Despesa"><span>Despesa</span></label>
            <label><input type="radio" asp-for="Type" value="Receita"><span>Receita</span></label>
        </div>

        <div class="field-grid two">
            <label><span>Descrição</span><input asp-for="Description" placeholder="Ex.: Internet, salário, supermercado" /></label>
            <label><span>Valor total</span><input asp-for="Amount" type="number" step="0.01" placeholder="0,00" /></label>
        </div>

        <div class="field-grid two">
            <label><span>Categoria</span>
                <select asp-for="Category">
                    <option>Moradia</option><option>Alimentação</option><option>Transporte</option><option>Saúde</option><option>Educação</option><option>Lazer</option><option>Assinaturas</option><option>Salário</option><option>Investimentos</option><option>Outros</option>
                </select>
            </label>
            <label><span>Subcategoria</span><input asp-for="Subcategory" placeholder="Opcional" /></label>
        </div>

        <div class="field-grid three">
            <label><span>Data</span><input asp-for="Date" type="date" /></label>
            <label><span>Vencimento</span><input asp-for="DueDate" type="date" /></label>
            <label><span>Status</span><select asp-for="Status"><option>Pago</option><option>Pendente</option><option>Vencido</option></select></label>
        </div>

        <div class="field-grid two">
            <label><span>Forma de pagamento</span>
                <select asp-for="PaymentMethod"><option>Pix</option><option>Dinheiro</option><option>Débito</option><option>Crédito</option><option>Boleto</option><option>Transferência</option></select>
            </label>
            <label><span>Conta / cartão</span><input asp-for="AccountName" placeholder="Ex.: Nubank, Itaú, Dinheiro" /></label>
        </div>

        <div class="field-grid two">
            <label><span>Modalidade</span>
                <select asp-for="RecurrenceType" data-recurrence>
                    <option value="Avulso">À vista / avulso</option>
                    <option value="Parcelado">Parcelado</option>
                    <option value="Recorrente">Recorrente</option>
                </select>
            </label>
            <label data-installments hidden><span>Número de parcelas</span><input asp-for="InstallmentTotal" type="number" min="2" max="120" placeholder="Ex.: 10" /></label>
        </div>

        <label><span>Observações</span><textarea asp-for="Notes" rows="3" placeholder="Opcional"></textarea></label>

        <div class="form-actions">
            <a class="secondary-btn" asp-action="Index">Cancelar</a>
            <button class="primary-btn" type="submit">Salvar lançamento</button>
        </div>
    </form>
</div>
