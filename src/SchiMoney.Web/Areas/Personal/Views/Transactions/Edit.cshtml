@model PersonalTransaction
@{
    ViewData["Title"] = "Editar lançamento";
    var sources = ViewBag.Sources as List<string> ?? [];
}
<div class="form-shell">
<div class="form-heading"><span class="eyebrow">Módulo Pessoal</span><h2>Editar movimentação</h2><p>Altere os dados desta ocorrência.</p></div>
<form method="post" class="smart-form">
<div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="segmented"><label><input type="radio" asp-for="Type" value="Despesa"><span>Despesa</span></label><label><input type="radio" asp-for="Type" value="Receita"><span>Receita</span></label></div>
<div class="field-grid two"><label><span>Descrição</span><input asp-for="Description" required /></label><label><span>Valor</span><input asp-for="Amount" type="number" step="0.01" min="0.01" required /></label></div>
<div class="field-grid two">
<label><span>Categoria</span><select asp-for="Category"><option>Moradia</option><option>Alimentação</option><option>Transporte</option><option>Saúde</option><option>Educação</option><option>Lazer</option><option>Assinaturas</option><option>Salário</option><option>Renda extra</option><option>Investimentos</option><option>Impostos</option><option>Outros</option></select></label>
<label><span>Subcategoria</span><input asp-for="Subcategory" /></label>
</div>
<div class="field-grid three"><label><span>Data</span><input asp-for="Date" type="date" /></label><label><span>Vencimento</span><input asp-for="DueDate" type="date" /></label><label><span>Status</span><select asp-for="Status"><option>Pago</option><option>Pendente</option><option>Vencido</option></select></label></div>
<div class="field-grid two">
<label><span>Forma de pagamento</span><select asp-for="PaymentMethod"><option>Pix</option><option>Dinheiro</option><option>Débito</option><option>Crédito</option><option>Boleto</option><option>Transferência</option><option>Débito automático</option></select></label>
<label><span>Conta / cartão</span><input asp-for="AccountName" list="financial-sources-edit" /><datalist id="financial-sources-edit">@foreach(var source in sources){<option value="@source"></option>}</datalist></label>
</div>
<label><span>Observações</span><textarea asp-for="Notes" rows="3"></textarea></label>
<div class="form-actions"><a class="secondary-btn" asp-action="Index">Cancelar</a><button class="primary-btn" type="submit">Salvar alterações</button></div>
</form>
</div>
